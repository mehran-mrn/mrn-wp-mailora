{
  "name": "mehran-mrn/mrn-wp-mailora",
  "description": "Professional multi-transport email delivery for WordPress.",
  "authors": [
    {
      "name": "mehran marandi",
      "homepage": "https://mehranmarandi.ir"
    }
  ],
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpcompatibility/php-compatibility": "^9.3",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
